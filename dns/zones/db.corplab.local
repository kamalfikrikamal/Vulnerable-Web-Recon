$TTL 3600
@       IN  SOA ns1.corplab.local. admin.corplab.local. (
                2024031202 ; serial
                3600       ; refresh
                900        ; retry
                604800     ; expire
                3600 )     ; minimum ttl

@       IN  NS   ns1.corplab.local.

; --- record publik / mudah ditemukan ---
@       IN  A    127.0.0.1
www     IN  A    127.0.0.1
ns1     IN  A    127.0.0.1
mail    IN  A    127.0.0.1

; --- record internal, TIDAK ditautkan di website manapun ---
; hanya ditemukan lewat DNS zone transfer (dig axfr) atau SAN sertifikat TLS
admin   IN  A    127.0.0.1
dev     IN  A    127.0.0.1
staging IN  A    127.0.0.1
api     IN  A    127.0.0.1
git     IN  A    127.0.0.1
backup  IN  A    127.0.0.1

; --- dead end yang disengaja: record ada, tapi tidak ada vhost khusus ---
; mengakses nama ini hanya jatuh ke situs default (bukan aplikasi berbeda) -
; tetap penting dilaporkan: tidak semua hasil DNS enum berarti ada
; permukaan serangan baru yang berbeda
vpn     IN  A    127.0.0.1
monitor IN  A    127.0.0.1

@       IN  TXT  "v=spf1 mx ~all"
@       IN  TXT  "internal-note=jangan buka allow-transfer ke publik - tiket OPS-1187"
@       IN  TXT  "flag-dns-axfr=NUSA{4xfr_s3h4rusny4_d1b4t4s1}"
